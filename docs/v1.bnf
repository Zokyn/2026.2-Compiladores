# v1
"""
    Versão da BNF com acréscimo de 'argumentos' como uma alteranativa aos itens
    do construtor, em comporação com a 'atribuição' que é utilizada para definir 
    um valor diretamente ao atributo do componente sem precisar declarar o nome
    (identificador) do atributo.
"""

<documento>             ::= [ <declaracao> ] <componente> 
<declaracao>            ::= "dados" IDENTIFICADOR <bloco_dados>
<bloco_dados>           ::= ABRE_BLOCO <dado> <mais_dado> FECHA_BLOCO | ε

<dado>                  ::= IDENTIFICADOR <bloco_construtor> 
<mais_dado>             ::= "," <dado> <mais_dado> | ε

<atribuicao>            ::= IDENTIFICADOR ":" <valor> | <valor>
<mais_atribuicao>       ::= "," <atribuicao> <mais_atribuicao> | ε

<argumento>             ::= <valor>
<mais_argumento>        ::= "," <argumento> <mais_argumento> | ε

<componente>            ::= <classe_componente> IDENTIFICADOR <bloco_construtor> [ <bloco_componente> ]

<bloco_construtor>      ::= ABRE_CONSTRUTOR <atribuicao> <mais_atribuicao> FECHA_CONSTRUTOR 
                          | ABRE_CONSTRUTOR <argumento> <mais_argumento> FECHA_CONSTRUTOR 

<bloco_componente>      ::= ABRE_BLOCO <componente> <mais_componente> FECHA_BLOCO | ε
<mais_componente>       ::= "," <componente> <mais_componente> | ε

<classe_componente>     ::= "pagina" | "botao" | "seccao" | "cartao" | "selo"

<valor>                 ::= NUMERO_REAL | NUMERO_INTEIRO | IDENTIFICADOR | TEXTO_LITERAL