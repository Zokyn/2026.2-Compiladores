# v1.5
"""
Gramática LL(1) para o analisador sintático descendente recursivo.
Cada não-terminal <x> corresponde a um método X() no Parser.

Terminais (em MAIÚSCULAS) correspondem ao TokenType do léxico:
  DADOS               "dados"
  COMPONENTE          pagina | secao | cartao | botao | selo
  IDENTIFICADOR       produtos, pag-loja, item, ...
  TEXTO_LITERAL       "Olá"
  NUMERO_INTEIRO      42
  NUMERO_REAL         4.2 | .5
  ABRE_CONSTRUTOR     (            FECHA_CONSTRUTOR    )
  ABRE_BLOCO          {            FECHA_BLOCO         }
  ABRE_TUPLA          [            FECHA_TUPLA         ]
  ATRIBUIDOR          :            SEPARADOR           ,
  ACESSO              .
  OPERADOR_RELACIONAL == | != | >= | <= | > | <
  OPERADOR_LOGICO     && | ||
  INCREMENTO          ++           DECREMENTO          --
  FIM_DE_ARQUIVO

Palavras entre aspas ("para", "em", "se", "enquanto", "sendo") são tokens
do tipo Controle cujo Valor é a própria palavra.
"""

# Documento

<documento>                 ::= <declaracoes> <componente> FIM_DE_ARQUIVO


# Dados
# Ex.: `dados turma <dados>` 
<declaracoes>               ::= <declaracao> <declaracoes> | ε 
<declaracao>                ::= DADOS IDENTIFICADOR <dados> | ε
<dados>                     ::= <conjunto_dados>
                              | <construtor>
                              | ATRIBUIDOR <valor>

# Conjunto de Dados
# Ex.: ["abobóra", "tomate", "maçã"] ou [aluno(turma, matricula, nota), aluno(...), ...]
<conjunto_dados>            ::= ABRE_TUPLA <itens_dados> FECHA_TUPLA
<itens_dados>               ::= <item_dado> <mais_itens>
<mais_itens>                ::= SEPARADOR <item_dado> <mais_itens> | ε
<item_dado>                 ::= IDENTIFICADOR <resto_item_dado> | <literal>
<resto_item_dado>           ::= <construtor> | <acesso>

# Componentes

<componente>                ::= COMPONENTE <nome_componente> <construtor> <bloco_componente_opcional>
<nome_componente>           ::= IDENTIFICADOR | ε

# Construtor

<construtor>                ::= ABRE_CONSTRUTOR <lista_argumentos> FECHA_CONSTRUTOR
<lista_argumentos>          ::= <argumento> <mais_argumentos> | ε
<mais_argumentos>           ::= SEPARADOR <argumento> <mais_argumentos> | ε
<argumento>                 ::= IDENTIFICADOR <resto_argumento> | <literal>
<resto_argumento>           ::= ATRIBUIDOR <valor> | <acesso>

# Bloco Componente

<bloco_componente_opcional> ::= <bloco_componente> | ε
<bloco_componente>          ::= ABRE_BLOCO <conteudo> FECHA_BLOCO
<conteudo>                  ::= <elemento> <mais_conteudo>
<elemento>                  ::= <componente> | <iteracao> | <condicional>
<mais_conteudo>             ::= SEPARADOR <elemento> <mais_conteudo> | ε

# Controle
<iteracao>                  ::= "para" IDENTIFICADOR <resto_para> <bloco_componente>
                              | "enquanto" <condicao> <bloco_componente>
<resto_para>                ::= "em" <colecao>
                              | "enquanto" <condicao> "sendo" <passo>
<colecao>                   ::= IDENTIFICADOR <acesso> | <conjunto_dados>  

<passo>                     ::= IDENTIFICADOR <resto_passo>
<resto_passo>               ::= ATRIBUIDOR <valor> | INCREMENTO | DECREMENTO

<condicional>               ::= "se" <condicao> <bloco_componente>

<condicao>                  ::= <comparacao> <mais_condicao>
<mais_condicao>             ::= OPERADOR_LOGICO <comparacao> <mais_condicao> | ε

# Comparacao

<comparacao>                ::= <valor> <resto_comparacao>
<resto_comparacao>          ::= OPERADOR_RELACIONAL <valor> | ε

# Valores
<valor>                     ::= <literal> | IDENTIFICADOR <acesso>
<acesso>                    ::= <sufixo> <acesso> | ε
<sufixo>                    ::= <membro_sufixo> | <indice_sufixo> 
<membro_sufixo>             ::= ACESSO IDENTIFICADOR
<indice_sufixo>             ::= ABRE_TUPLA NUMERO_INTEIRO FECHA_TUPLA
<literal>                   ::= TEXTO_LITERAL | NUMERO_INTEIRO | NUMERO_REAL
