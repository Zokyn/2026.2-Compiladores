# v0
"""
        Versão da BNF com documento consitutido por uma declaração de dados opcional e um componente obrigatório, 
    servindo como raiz para a construção de uma interface gráfica. A declaração de dados define um conjunto 
    de dados que podem ser utilizados pelos componentes, enquanto o componente define a estrutura e os 
    elementos da interface.
"""
<documento>             ::= [ <declaracao> ] <componente> 
<declaracao>            ::= "dados" IDENTIFICADOR [ <bloco_dados> ]
<bloco_dados>           ::= ABRE_BLOCO <dado> <mais_dado> FECHA_BLOCO

<dado>                  ::=  IDENTIFICADOR <bloco_construtor> | <atribuicao>
<mais_dado>             ::= "," <dado> <mais_dado> | ε

<atribuicao>            ::= IDENTIFICADOR ":" <valor> 
<mais_atribuicao>        ::= "," <atribuicao> <mais_atribuicao> | ε

<componente>            ::= <classe_componente> IDENTIFICADOR  <bloco_construtor>  [ <bloco_componente> ]

<bloco_construtor>      ::= ABRE_CONSTRUTOR <atribuicao> <mais_atribuicao> FECHA_CONSTRUTOR 

<bloco_componente>       ::= ABRE_BLOCO <componente> <mais_componente> FECHA_BLOCO
                        ::= ABRE_BLOCO <laco_ FECHA_BLOCO
<mais_componente>        ::= "," <componente> <mais_componente> | ε


<classe_componente>      ::= "pagina" | "botao" | "seccao" | "cartao" | "selo"

<valor>                  ::= NUMERO_REAL | NUMERO_INTEIRO | IDENTIFICADOR | TEXTO_LITERAL

# ε -> símbolo vazio